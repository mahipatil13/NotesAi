# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (for administrative tasks if needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Gemini API Key for AI generation (Flashcards, Quizzes, Chat, Exam packs)
GEMINI_API_KEY=your-gemini-api-key-here

# Superadmin emails — comma-separated list of email addresses that receive the superadmin role.
# Keeping this in an env variable prevents email addresses from being compiled into the JS bundle.
# Example: NEXT_PUBLIC_SUPERADMIN_EMAILS=admin@yourdomain.com,owner@yourdomain.com
NEXT_PUBLIC_SUPERADMIN_EMAILS=admin@yourdomain.com
